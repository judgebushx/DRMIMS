<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- IIS HTTP Platform Handler -->
    <handlers>
      <add name="httpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified" />
    </handlers>

    <!-- HTTP to HTTPS redirect -->
    <rewrite>
      <rules>
        <rule name="Redirect HTTP to HTTPS"
              stopProcessing="true">

          <match url="(.*)" />

          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>

          <action type="Redirect"
                  url="https://fsmdisastermanagement.info/{R:1}"
                  redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>

    <!-- Django / Waitress -->
    <httpPlatform
        processPath="C:\Users\Administrator\Documents\CODEBASE\virtenv\Scripts\python.exe"
        arguments="C:\Users\Administrator\Documents\CODEBASE\virtenv\DRMIMS\run_waitress.py"
        startupTimeLimit="120"
        startupRetryCount="5"
        stdoutLogEnabled="true"
        stdoutLogFile="C:\Users\Administrator\Documents\CODEBASE\virtenv\DRMIMS\logs\stdout.log">

      <environmentVariables>

        <environmentVariable
            name="DJANGO_SETTINGS_MODULE"
            value="config.settings" />

        <environmentVariable
            name="PYTHONUNBUFFERED"
            value="1" />

        <environmentVariable
            name="SERVER_PORT"
            value="%HTTP_PLATFORM_PORT%" />

        <environmentVariable
            name="PYTHONPATH"
            value="C:\Users\Administrator\Documents\CODEBASE\virtenv\DRMIMS" />

      </environmentVariables>

    </httpPlatform>

  </system.webServer>
</configuration>